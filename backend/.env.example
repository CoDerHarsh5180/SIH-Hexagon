# Server Environment & Port
PORT=5000
NODE_ENV=development

# MongoDB Database Connection String
MONGO_URI=mongodb://127.0.0.1:27017/saral_db

# JSON Web Token Secret & Expiration
JWT_SECRET=saral_jwt_secret_key_2026_super_secure_key
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Client / Frontend Origin for CORS
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Optional in development - OTP & tokens log to console simulator)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME="SARAL Industrial Single-Window"
FROM_EMAIL=no-reply@saral.gov.in
